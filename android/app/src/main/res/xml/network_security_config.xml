<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Deliberate app-scoped support for owner-installed private LAN CA.
         Default hostname verification is mandatory; no trust-all code. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
