<Window x:Class="VeyPanel.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="VeyPanel Desktop • Alpha" Width="1000" Height="620" MinWidth="760" MinHeight="460">
 <DockPanel Margin="20">
   <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
     <TextBlock Text="VeyPanel" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="Display diagnostics • Local only • Read / validate only" Margin="0,4,0,12" Foreground="#526577"/>
     <WrapPanel>
       <Button x:Name="RefreshButton" Click="Refresh_Click" Content="Refresh displays" Padding="14,7" Margin="0,0,8,0"/>
       <Button x:Name="ValidateButton" Click="Validate_Click" Content="Validate current topology" Padding="14,7"/>
       <TextBlock Text="Minimize to tray; close to exit." VerticalAlignment="Center" Margin="12,0,0,0"/>
     </WrapPanel>
   </StackPanel>
   <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Text="Ready" TextWrapping="Wrap" Margin="0,12,0,0" />
   <TabControl>
     <TabItem Header="Telemetry">
       <StackPanel Margin="18">
         <TextBlock Text="Local monitoring" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <TextBlock Text="Start the bundled Host and open the CPU/RAM dashboard. This mode listens only on loopback." TextWrapping="Wrap"/>
         <WrapPanel Margin="0,18,0,12">
           <Button x:Name="StartHostButton" Click="StartHost_Click" Content="Start Host" Padding="14,7" Margin="0,0,8,0"/>
           <Button x:Name="StopHostButton" Click="StopHost_Click" Content="Stop Host" Padding="14,7" Margin="0,0,8,0" IsEnabled="False"/>
           <Button x:Name="DashboardButton" Click="Dashboard_Click" Content="Open Dashboard" Padding="14,7" IsEnabled="False"/>
         </WrapPanel>
         <TextBlock x:Name="HostStatus" Text="Stopped" TextWrapping="Wrap"/>
       </StackPanel>
     </TabItem>
     <TabItem Header="Apollo">
       <ScrollViewer VerticalScrollBarVisibility="Auto">
         <StackPanel Margin="18" MaxWidth="660" HorizontalAlignment="Left">
           <TextBlock Text="Local Apollo management" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
           <TextBlock Text="Requires separately installed Apollo v0.4.6. Verify the certificate fingerprint independently from the actual local certificate file. Login may replace an existing Apollo Web UI session." TextWrapping="Wrap"/>
           <TextBlock Text="Verified certificate SHA-256" Margin="0,12,0,3"/>
           <TextBox x:Name="ApolloPinHash" MaxLength="95"/>
           <TextBlock Text="Username" Margin="0,8,0,3"/>
           <TextBox x:Name="ApolloUsername" MaxLength="128"/>
           <TextBlock Text="Password (not saved)" Margin="0,8,0,3"/>
           <PasswordBox x:Name="ApolloPassword" MaxLength="1024"/>
           <Button x:Name="ApolloInspectButton" Content="Inspect Apollo" Click="ApolloInspect_Click" HorizontalAlignment="Left" Padding="14,7" Margin="0,12,0,8"/>
           <Separator Margin="0,8"/>
           <TextBlock Text="Pair a tablet you physically control. The first paired client may receive broad permissions; verify them in Apollo." TextWrapping="Wrap"/>
           <TextBlock Text="Device name" Margin="0,8,0,3"/>
           <TextBox x:Name="ApolloDeviceName" MaxLength="64"/>
           <TextBlock Text="Four-digit PIN shown on the tablet" Margin="0,8,0,3"/>
           <PasswordBox x:Name="ApolloDevicePin" MaxLength="4"/>
           <Button x:Name="ApolloPairButton" Click="ApolloPair_Click" Content="Pair device…" HorizontalAlignment="Left" Padding="14,7" Margin="0,12,0,8"/>
           <TextBlock x:Name="ApolloStatus" Text="Not connected" TextWrapping="Wrap" Margin="0,6"/>
           <ListBox x:Name="ApolloApps" Height="100"/>
         </StackPanel>
       </ScrollViewer>
     </TabItem>
     <TabItem Header="Desktop sources">
       <DataGrid x:Name="SourcesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
         <DataGrid.Columns>
           <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140"/>
           <DataGridTextColumn Header="Adapter" Binding="{Binding Adapter}" Width="*"/>
           <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="120"/>
           <DataGridTextColumn Header="Refresh" Binding="{Binding Refresh}" Width="90"/>
           <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="100"/>
           <DataGridTextColumn Header="Primary" Binding="{Binding Primary}" Width="80"/>
         </DataGrid.Columns>
       </DataGrid>
     </TabItem>
     <TabItem Header="Active topology">
       <DataGrid x:Name="PathsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
         <DataGrid.Columns>
           <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140"/>
           <DataGridTextColumn Header="Monitor" Binding="{Binding Monitor}" Width="*"/>
           <DataGridTextColumn Header="Target ID" Binding="{Binding Target}" Width="90"/>
           <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="120"/>
           <DataGridTextColumn Header="Rotation" Binding="{Binding Rotation}" Width="90"/>
           <DataGridTextColumn Header="Identity" Binding="{Binding Identity}" Width="95"/>
         </DataGrid.Columns>
       </DataGrid>
     </TabItem>
   </TabControl>
 </DockPanel>
</Window>
