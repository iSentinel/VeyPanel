<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0-alpha.10</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VeyPanel.Smoke" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../scripts/Get-StorageHealth.ps1" Link="diagnostics/Get-StorageHealth.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../scripts/StorageHealth.psm1" Link="diagnostics/StorageHealth.psm1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="[10.0.15]" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="[3.2.1]" />
    <Content Include="../../third-party/Codecrete-QrCodeGenerator-LICENSE.txt" Link="third-party/Codecrete-QrCodeGenerator-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
